<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Intermediate names so dotted MallTracker styles resolve. -->
    <style name="TextAppearance.MallTracker" parent="TextAppearance.Material3.BodyLarge" />

    <style name="Widget.MallTracker" parent="android:Widget" />

    <!-- Typography -->
    <style name="TextAppearance.MallTracker.LargeHeading" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_large_heading</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="TextAppearance.MallTracker.ScreenHeading" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_screen_heading</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.MallTracker.SectionHeading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_section_heading</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.MallTracker.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.MallTracker.SecondaryBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_secondary_body</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.MallTracker.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.MallTracker.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.MallTracker.MapLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_map_label</item>
        <item name="android:textColor">@color/map_label</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.MallTracker.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.MallTracker.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/on_primary</item>
    </style>

    <style name="Widget.MallTracker.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.MallTracker.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.MallTracker.Button.Prominent" parent="Widget.MallTracker.Button.Primary">
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/on_secondary</item>
        <item name="rippleColor">@color/on_secondary</item>
        <item name="iconTint">@color/on_secondary</item>
    </style>

    <style name="Widget.MallTracker.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.MallTracker.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.MallTracker.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/icon_button_size</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.MallTracker.FloorButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/floor_button_height</item>
        <item name="android:minWidth">@dimen/floor_button_min_width</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">@dimen/space_md</item>
        <item name="android:paddingRight">@dimen/space_md</item>
        <item name="android:textAppearance">@style/TextAppearance.MallTracker.Caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/floor_button_background</item>
        <item name="android:textColor">@color/floor_button_text</item>
        <item name="strokeColor">@color/floor_button_stroke</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
    </style>

    <!-- Cards, chips, search, navigation -->
    <style name="Widget.MallTracker.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="rippleColor">@color/primary_container</item>
    </style>

    <style name="Widget.MallTracker.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/stroke_width</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.MallTracker.Caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <style name="Widget.MallTracker.SearchField" parent="android:Widget.EditText">
        <item name="android:background">@null</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAppearance">@style/TextAppearance.MallTracker.Body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:inputType">text</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.MallTracker.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.MallTracker.Caption</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.MallTracker.Caption</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>

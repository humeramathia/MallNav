<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal">

    <ImageView
        android:id="@+id/iv_brand_mark"
        android:layout_width="@dimen/splash_mark_size"
        android:layout_height="@dimen/splash_mark_size"
        android:background="@drawable/bg_brand_mark"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_md"
        android:src="@drawable/ic_mall"
        app:layout_constraintBottom_toTopOf="@id/tv_app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/secondary" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.MallTracker.LargeHeading"
        app:layout_constraintBottom_toTopOf="@id/splash_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_brand_mark" />

    <View
        android:id="@+id/splash_accent"
        android:layout_width="@dimen/splash_accent_width"
        android:layout_height="@dimen/splash_accent_height"
        android:layout_marginTop="@dimen/space_md"
        android:background="@color/secondary"
        app:layout_constraintBottom_toTopOf="@id/tv_tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_app_name" />

    <TextView
        android:id="@+id/tv_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:gravity="center"
        android:text="@string/app_tagline"
        android:textAppearance="@style/TextAppearance.MallTracker.SecondaryBody"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_accent" />
</androidx.constraintlayout.widget.ConstraintLayout>

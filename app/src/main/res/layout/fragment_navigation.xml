<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/charcoal_deep"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_camera_preview"
        app:implementationMode="compatible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <LinearLayout
        android:id="@+id/camera_fallback"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_camera_fallback"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/camera_permission_body"
            android:textAppearance="@style/TextAppearance.MallTracker.Body"
            android:textColor="@color/on_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enable_camera"
            style="@style/Widget.MallTracker.Button.Prominent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/action_enable_camera" />
    </LinearLayout>

    <View
        android:id="@+id/top_scrim"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@color/camera_scrim"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/on_camera" />

    <TextView
        android:id="@+id/tv_to"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.MallTracker.ScreenHeading"
        android:textColor="@color/on_camera"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toStartOf="@id/live_badge"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        tools:text="To Nike" />

    <LinearLayout
        android:id="@+id/live_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_md"
        android:background="@drawable/bg_live_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_xxs"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xxs"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_back">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_live_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/camera_live"
            android:textAppearance="@style/TextAppearance.MallTracker.Caption"
            android:textColor="@color/on_camera" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_from"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:textAppearance="@style/TextAppearance.MallTracker.SecondaryBody"
        android:textColor="@color/on_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        tools:text="Starting near Clicks" />

    <TextView
        android:id="@+id/label_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:background="@drawable/bg_ar_chip"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.MallTracker.Caption"
        android:textColor="@color/on_camera"
        app:layout_constraintBottom_toTopOf="@id/iv_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_from"
        tools:text="Woolworths" />

    <TextView
        android:id="@+id/label_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ar_chip"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_xs"
        android:text="@string/ar_label_corridor"
        android:textAppearance="@style/TextAppearance.MallTracker.Caption"
        android:textColor="@color/on_camera"
        app:layout_constraintBottom_toTopOf="@id/iv_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/label_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_lg"
        android:background="@drawable/bg_ar_chip"
        android:paddingStart="@dimen/space_md"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_md"
        android:paddingBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.MallTracker.Caption"
        android:textColor="@color/on_camera"
        app:layout_constraintBottom_toTopOf="@id/iv_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_from"
        app:layout_constraintVertical_bias="0.35"
        tools:text="Nike" />

    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/cd_nav_arrow"
        android:src="@drawable/ic_nav_arrow"
        app:layout_constraintBottom_toTopOf="@id/instruction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_from" />

    <TextView
        android:id="@+id/tv_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_distance_live"
        android:textAppearance="@style/TextAppearance.MallTracker.SectionHeading"
        android:textColor="@color/on_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_arrow" />

    <FrameLayout
        android:id="@+id/map_frame"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:background="@drawable/bg_map_canvas"
        android:padding="@dimen/space_sm"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/instruction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone">

        <include layout="@layout/view_floor_plan" />
    </FrameLayout>

    <include
        android:id="@+id/instruction"
        layout="@layout/view_navigation_instruction_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:layout_marginBottom="@dimen/space_sm"
        app:layout_constraintBottom_toTopOf="@id/btn_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/btn_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding_horizontal"
        android:layout_marginEnd="@dimen/screen_padding_horizontal"
        android:layout_marginBottom="@dimen/space_md"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_view"
            style="@style/Widget.MallTracker.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/action_show_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_floor"
            style="@style/Widget.MallTracker.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/nav_go_level_2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_end"
            style="@style/Widget.MallTracker.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/action_end_navigation" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

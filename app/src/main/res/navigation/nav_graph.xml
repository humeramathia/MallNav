<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.mallnav.ui.splash.SplashFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.mallnav.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/mallHomeFragment"
        android:name="com.example.mallnav.ui.mall.MallHomeFragment"
        android:label="@string/mall_home_subtitle"
        tools:layout="@layout/fragment_mall_home" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.mallnav.ui.map.MapFragment"
        android:label="@string/nav_map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/directoryFragment"
        android:name="com.example.mallnav.ui.directory.DirectoryFragment"
        android:label="@string/nav_directory"
        tools:layout="@layout/fragment_directory" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.mallnav.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/storeDetailsFragment"
        android:name="com.example.mallnav.ui.store.StoreDetailsFragment"
        android:label="@string/cd_store_card"
        tools:layout="@layout/fragment_store_details" />

    <fragment
        android:id="@+id/storeListFragment"
        android:name="com.example.mallnav.ui.store.StoreListFragment"
        android:label="@string/directory_title"
        tools:layout="@layout/fragment_store_list" />

    <fragment
        android:id="@+id/routeSearchFragment"
        android:name="com.example.mallnav.ui.navigate.RouteSearchFragment"
        android:label="@string/action_navigate"
        tools:layout="@layout/fragment_route_search" />

    <fragment
        android:id="@+id/confirmStartFragment"
        android:name="com.example.mallnav.ui.navigate.ConfirmStartFragment"
        android:label="@string/confirm_title"
        tools:layout="@layout/fragment_confirm_start" />

    <fragment
        android:id="@+id/routePreviewFragment"
        android:name="com.example.mallnav.ui.navigate.RoutePreviewFragment"
        android:label="@string/route_title"
        tools:layout="@layout/fragment_route_preview" />

    <fragment
        android:id="@+id/navigationFragment"
        android:name="com.example.mallnav.ui.navigate.NavigationFragment"
        android:label="@string/action_navigate"
        tools:layout="@layout/fragment_navigation" />

    <fragment
        android:id="@+id/placeholderFragment"
        android:name="com.example.mallnav.ui.common.PlaceholderFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_placeholder" />
</navigation>
